# 1. Base Python image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Set working directory inside container
WORKDIR /app

# Install system dependencies (C++ build tools required for ChromaDB / SQLite)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file first for layer caching
COPY requirements.txt .

# Install Python packages
RUN pip install --no-cache-dir -r requirements.txt

# Copy all project files into container
COPY . .

# Expose ports (FastAPI on 8000, Streamlit on 8501)
EXPOSE 8000 8501

# Entrypoint script or command to run both backend and frontend,
# OR run Streamlit / FastAPI directly depending on your setup.
# Assuming Streamlit app launcher:
CMD ["./start.sh"]